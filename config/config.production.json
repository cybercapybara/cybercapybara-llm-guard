{
  "_comment": "Production profile: every security toggle ON, every dev convenience OFF. Validate with `make prod-check` before deploying. Secrets come ONLY from the environment \u2014 this file must never contain literal credentials.",
  "app": {
    "env": "production"
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "threads": "${SERVER_THREADS:-4}",
    "max_body_bytes": 10485760,
    "ssl": {
      "enabled": false
    }
  },
  "shutdown": {
    "pre_stop_delay_sec": 5
  },
  "logging": {
    "name": "${LOG_NAME:-llm_guard}",
    "file": "logs/app.log",
    "level": "${LOG_LEVEL:-info}",
    "format": "json"
  },
  "observability": {
    "metrics_address": "0.0.0.0:9090",
    "service_name": "${SERVICE_NAME:-llm_guard_service}",
    "otlp_endpoint": "${OTLP_ENDPOINT:-}"
  },
  "database": {
    "primary": "postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT:-5432}/${DATABASE_NAME}",
    "replicas": [],
    "pool_size": "${DB_POOL_SIZE:-10}",
    "acquire_timeout_ms": 5000,
    "statement_timeout_ms": 30000,
    "migrations_enabled": false,
    "migrations_dir": "migrations"
  },
  "cache": {
    "use_sentinel": "${REDIS_USE_SENTINEL:-false}",
    "url": "tcp://${REDIS_HOST}:${REDIS_PORT:-6379}",
    "password": "${REDIS_PASSWORD}",
    "pool_size": "${CACHE_POOL_SIZE:-10}",
    "sentinel": {
      "password": "${REDIS_SENTINEL_PASSWORD:-}",
      "master_name": "${REDIS_MASTER_NAME:-mymaster}",
      "nodes": []
    }
  },
  "docs": {
    "enabled": false
  },
  "security": {
    "hsts": true,
    "hsts_max_age": 31536000
  }
}
